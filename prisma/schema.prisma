datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Medicine {
  id          String   @id @default(cuid())
  name        String
  composition String?
  category    String?
  batches     Batch[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Batch {
  id           String   @id @default(cuid())
  medicineId   String
  medicine     Medicine @relation(fields: [medicineId], references: [id])
  batchNo      String
  expiryDate   DateTime
  mrp          Float
  purchaseRate Float
  saleRate     Float
  stock        Int      @default(0)
  saleItems    SaleItem[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Sale {
  id           String     @id @default(cuid())
  invoiceNo    String     @unique
  date         DateTime   @default(now())
  customerName String?
  totalAmount  Float
  items        SaleItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id])
  batchId   String
  batch     Batch    @relation(fields: [batchId], references: [id])
  quantity  Int
  rate      Float
  amount    Float
}
